<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /api/

    # Pass Authorization header through to PHP (required for Bearer tokens / Sanctum)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Route all requests to Laravel's index.php (skip actual files)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
